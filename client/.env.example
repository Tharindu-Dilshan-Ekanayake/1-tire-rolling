# >>> FILL ME IN <<<
# The game slug from your Bloxity developer dashboard.
# Copy this file to `.env` (or `.env.local`) and replace the placeholder.
VITE_GAME_SLUG=MY_GAME_SLUG

# Bloxity environment (api / play / portal / static URLs): NOT configured here.
# The page that hosts the game sets window.BLOXITY_ENV and the SDK reads it; with none,
# production. In `npm run dev` the Vite plugin in vite.config.js injects a LOCAL Boxity
# stack (api :4000, play :2567, portal :3000). To develop against production instead:
#   BLOXITY_DEV_ENV=prod npm run dev
# (a shell variable, not a VITE_ one - it only affects the dev server, never a build).

# Hosted on Bloxity Legion: join through its matchmaker (the deploy workflow sets
# this for hosted builds). Also the hosting id for ?roomId= links (room directory).
# VITE_LEGION_GAME_ID=1-tire-rolling

# Or a game server (Colyseus) reached directly. Leave both unset in development to use
# http://<host>:2567; a production build with neither plays offline with a local save.
# VITE_SERVER_URL=https://game.example.com
